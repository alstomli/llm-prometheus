# Bare Pod ID per profile. Leave one empty to skip that profile.
RUNPOD_4BIT_POD_ID=your-4bit-pod-id
RUNPOD_BF16_POD_ID=your-bf16-pod-id
# Old hostname variables, used only when both Pod IDs are empty.
RUNPOD_METRICS_TARGET=
# Comma-separated; overrides the single-target variable.
RUNPOD_METRICS_TARGETS=
RUNPOD_METRICS_TOKEN=replace-with-the-existing-pod-metrics-token
# Optional FLUX.2 backend; set both variables together. Keep this token distinct.
FLUX2_METRICS_TARGET=
FLUX2_METRICS_TOKEN=
METRICS_RETENTION_TIME=7d
METRICS_RETENTION_SIZE=512MB
PROMETHEUS_VOLUME_NAME=monitoring_prometheus-data
